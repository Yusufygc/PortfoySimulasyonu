/* =======================================================
   FEATURE - WATCHLIST
   Token referanslari: @TOKEN_ADI (bkz. src/ui/styles/tokens.py)
======================================================= */

QPushButton[cssClass="watchlistNewButton"] {
    background-color: @COLOR_SUCCESS;
    color: @COLOR_TEXT_WHITE;
    border: none;
    border-radius: @RADIUS_MD;
    font-weight: bold;
    padding: 6px 12px;
    font-size: @FONT_BASE;
}

QPushButton[cssClass="watchlistNewButton"]:hover {
    background-color: @COLOR_SUCCESS_HOVER;
}

QListWidget[cssClass="watchlistList"]::item {
    border-left: 3px solid transparent;
}

QListWidget[cssClass="watchlistList"]::item:selected,
QListWidget[cssClass="watchlistList"]::item:selected:!active {
    background-color: rgba(59, 130, 246, 0.12);
    border-left: 3px solid @COLOR_PRIMARY;
    color: @COLOR_TEXT_PRIMARY;
}

QFrame[cssClass="watchlistEmptyState"] {
    background-color: @COLOR_BG_SURFACE;
    border: 1px solid @COLOR_BORDER;
    border-radius: @RADIUS_LG;
}

QLabel[cssClass="watchlistEmptyTitle"] {
    color: @COLOR_TEXT_MUTED;
    font-size: @FONT_LG;
    font-weight: 600;
}

QTableWidget[cssClass="watchlistTable"] {
    background-color: @COLOR_BG_SURFACE;
    alternate-background-color: @COLOR_BG_BASE;
    color: @COLOR_TEXT_BRIGHT;
    border: 1px solid @COLOR_BORDER;
    border-radius: @RADIUS_LG;
    gridline-color: transparent;
    outline: none;
    selection-background-color: rgba(59, 130, 246, 0.22);
    selection-color: @COLOR_TEXT_WHITE;
}

QTableWidget[cssClass="watchlistTable"]::item {
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid @COLOR_BORDER_SUBTLE;
}

QTableWidget[cssClass="watchlistTable"]::item:hover {
    background-color: transparent;
}

QTableWidget[cssClass="watchlistTable"]::item:selected {
    background-color: transparent;
    color: @COLOR_TEXT_BRIGHT;
}

QTableWidget[cssClass="watchlistTable"] QHeaderView::section {
    background-color: @COLOR_BG_SURFACE;
    color: @COLOR_TEXT_PRIMARY;
    border: none;
    border-bottom: 2px solid @COLOR_BORDER;
    padding: 12px 10px;
    font-size: @FONT_MD;
    font-weight: bold;
}

QTableWidget[cssClass="watchlistTable"] QPushButton[cssClass="textButton"] {
    background-color: transparent;
    color: @COLOR_TEXT_PRIMARY;
    border: none;
    border-radius: @RADIUS_MD;
    padding: 4px;
}

QTableWidget[cssClass="watchlistTable"] QPushButton[cssClass="textButton"]:hover {
    background-color: @COLOR_BG_BASE;
}

QTableWidget[cssClass="watchlistTable"] QPushButton[cssClass="dangerTextButton"],
QTableWidget[cssClass="watchlistTable"] QPushButton[cssClass="dangerTextBtn"] {
    background-color: transparent;
    color: @COLOR_DANGER;
    border: none;
    border-radius: @RADIUS_MD;
    padding: 4px;
}

QTableWidget[cssClass="watchlistTable"] QPushButton[cssClass="dangerTextButton"]:hover,
QTableWidget[cssClass="watchlistTable"] QPushButton[cssClass="dangerTextBtn"]:hover {
    background-color: rgba(239, 68, 68, 0.12);
}
