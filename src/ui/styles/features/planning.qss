/* =======================================================
   FEATURE - PLANNING
   Token referanslari: @TOKEN_ADI (bkz. src/ui/styles/tokens.py)
======================================================= */

QLabel[cssClass="statusLabelInfo"] {
    background-color: @COLOR_BG_SURFACE; color: @COLOR_TEXT_SECONDARY;
    border-radius: @RADIUS_LG; padding: @SPACE_XL; font-size: @FONT_MD;
}
QLabel[cssClass="successHeader"] {
    color: @COLOR_SUCCESS; font-weight: bold; font-size: @FONT_XL;
}
QLabel[cssClass="dangerHeader"] {
    color: @COLOR_DANGER; font-weight: bold; font-size: @FONT_XL; margin-top: @SPACE_LG;
}
QLabel[cssClass="inputLabel"] {
    color: @COLOR_TEXT_BODY; font-size: @FONT_MD; font-weight: 500;
}

QLabel[cssClass="dangerHeader"] {
    margin-top: 2px;
}

/* -------------------------------------------------------
   BudgetFormPanel — dinamik kalem satırı ve ikon butonlar
------------------------------------------------------- */
QFrame[cssClass="budgetItemRow"] {
    background-color: @COLOR_BG_SURFACE;
    border-radius: @RADIUS_MD;
}
QFrame[cssClass="budgetItemRow"]:hover {
    background-color: @COLOR_BG_ELEVATED;
}

QPushButton[cssClass="iconButton"] {
    background: transparent;
    border: none;
    border-radius: @RADIUS_SM;
    padding: 3px;
}
QPushButton[cssClass="iconButton"]:hover {
    background-color: @COLOR_BG_ELEVATED;
}

QPushButton[cssClass="pinIconButton"] {
    background: transparent;
    border: none;
    border-radius: @RADIUS_SM;
    padding: 3px;
}
QPushButton[cssClass="pinIconButton"]:hover {
    background-color: @COLOR_BG_ELEVATED;
}
QPushButton[cssClass="pinIconButtonActive"] {
    background-color: rgba(59, 130, 246, 0.12);
    border: none;
    border-radius: @RADIUS_SM;
    padding: 3px;
}
QPushButton[cssClass="pinIconButtonActive"]:hover {
    background-color: rgba(59, 130, 246, 0.18);
}

QPushButton[cssClass="dangerIconButton"] {
    background: transparent;
    border: none;
    border-radius: @RADIUS_SM;
    padding: 3px;
}
QPushButton[cssClass="dangerIconButton"]:hover {
    background-color: rgba(239, 68, 68, 0.12);
}

QFrame[cssClass="verticalSeparator"] {
    background-color: @COLOR_BORDER;
    max-width: 1px;
    min-width: 1px;
    margin: 0 8px;
}

QFrame[cssClass="horizontalSeparator"] {
    background-color: @COLOR_BORDER;
    max-height: 1px;
    min-height: 1px;
    margin: 4px 0;
}

QTableWidget[cssClass="goalsTable"] QHeaderView::section {
    background-color: @COLOR_BG_SURFACE;
    color: @COLOR_PRIMARY;
    font-weight: bold;
    font-size: @FONT_MD;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid @COLOR_PRIMARY;
    text-transform: uppercase;
}

QPushButton[cssClass="tableActionButtonContrib"] {
    background-color: @COLOR_BG_BASE;
    border: 1px solid @COLOR_BORDER;
    border-radius: @RADIUS_SM;
    color: @COLOR_TEXT_PRIMARY;
    font-size: @FONT_XS;
    font-weight: 500;
    padding: 0px 8px;
    height: 26px;
}
QPushButton[cssClass="tableActionButtonContrib"]:hover {
    background-color: @COLOR_BG_ELEVATED;
}

QPushButton[cssClass="tableActionButtonDelete"] {
    background-color: @COLOR_DANGER;
    border: none;
    border-radius: @RADIUS_SM;
    color: @COLOR_TEXT_WHITE;
    font-size: @FONT_XS;
    font-weight: 500;
    padding: 0px 8px;
    height: 26px;
}
QPushButton[cssClass="tableActionButtonDelete"]:hover {
    background-color: @COLOR_DANGER_DARK;
}
