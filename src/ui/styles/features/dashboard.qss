/* =======================================================
   FEATURE - DASHBOARD
   Token referanslari: @TOKEN_ADI (bkz. src/ui/styles/tokens.py)
======================================================= */

QLabel[cssClass="summaryCardTitle"] {
    color: @COLOR_TEXT_BRIGHT;
    font-size: @FONT_BASE;
    font-weight: bold;
    padding-bottom: @SPACE_XS;
}

QLabel[cssClass="summaryCardValue"] {
    color: @COLOR_TEXT_BRIGHT;
    font-size: @FONT_3XL;
    font-weight: 700;
}
QLabel[cssClass="summaryCardValue"][state="positive"] { color: @COLOR_TEXT_BRIGHT; }
QLabel[cssClass="summaryCardValue"][state="neutral"] { color: @COLOR_TEXT_BRIGHT; }
QLabel[cssClass="summaryCardValue"][state="negative"] { color: @COLOR_DANGER; }

QLabel[cssClass="summaryCardContext"] {
    color: @COLOR_TEXT_MUTED;
    font-size: @FONT_SM;
    margin-top: 2px;
}
QLabel[cssClass="summaryCardContext"][state="positive"] {
    color: @COLOR_SUCCESS;
    font-size: @FONT_BASE;
    font-weight: 500;
}
QLabel[cssClass="summaryCardContext"][state="negative"] {
    color: @COLOR_DANGER;
    font-size: @FONT_BASE;
    font-weight: 500;
}

QLabel[cssClass="summaryCardSubTitle"] {
    color: @COLOR_TEXT_SECONDARY;
    font-size: @FONT_BASE;
    font-weight: 500;
}

QLabel[cssClass="summaryCardValueSmall"] {
    color: @COLOR_TEXT_BRIGHT;
    font-size: @FONT_LG;
    font-weight: 700;
}
QLabel[cssClass="summaryCardValueSmall"][state="positive"] { color: @COLOR_SUCCESS; }
QLabel[cssClass="summaryCardValueSmall"][state="negative"] { color: @COLOR_DANGER; }
QLabel[cssClass="summaryCardValueSmall"][state="neutral"]  { color: @COLOR_TEXT_PRIMARY; }

QLabel[cssClass="lastUpdateLabel"] {
    color: @COLOR_ACCENT;
    font-size: @FONT_MD;
    font-weight: 500;
}

QFrame[cssClass="summaryCard"] {
    background-color: @COLOR_CARD_SURFACE;
    border: 1px solid @COLOR_BORDER_SUBTLE;
    border-radius: @RADIUS_CARD;
}
QFrame[cssClass="summaryCard"][cardType="total"],
QFrame[cssClass="summaryCard"][cardType="cost"],
QFrame[cssClass="summaryCard"][cardType="capital"],
QFrame[cssClass="summaryCard"][cardType="returns"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @COLOR_CARD_SURFACE, stop:1 @COLOR_CARD_GRADIENT_TOTAL);
    border: 1px solid @CARD_TOTAL_BORDER;
}

QTableView {
    selection-background-color: @COLOR_TABLE_SELECTED_BG;
    selection-color: @COLOR_TEXT_PRIMARY;
}
