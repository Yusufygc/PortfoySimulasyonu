/* =======================================================
   FEATURE - AI (core)
   Butonlar, girdi alanları, kart konteyneri ve temel etiketler.
   Alt modüller: ai/chat.qss  ai/progress.qss  ai/xai.qss
   Token referanslari: @TOKEN_ADI (bkz. src/ui/styles/tokens.py)
======================================================= */

QPushButton[cssClass="aiActionButton"] {
    background-color: @COLOR_INDIGO; color: @COLOR_TEXT_WHITE;
    font-weight: bold; padding: @SPACE_XL; border-radius: @RADIUS_MD; font-size: @FONT_MD;
}
QPushButton[cssClass="aiActionButton"]:hover { background-color: @COLOR_INDIGO_HOVER; }
QPushButton[cssClass="aiActionButton"]:disabled { background-color: @COLOR_BORDER; color: @COLOR_TEXT_SECONDARY; }

QPushButton[cssClass="aiPrimaryBtn"] {
    background-color: @COLOR_ACCENT; color: @COLOR_BG_BASE;
    font-weight: bold; padding: @SPACE_LG 20px; border-radius: @RADIUS_MD; font-size: @FONT_MD;
}
QPushButton[cssClass="aiPrimaryBtn"]:hover { background-color: @COLOR_ACCENT_HOVER; }
QPushButton[cssClass="aiPrimaryBtn"]:disabled { background-color: @COLOR_BORDER; color: @COLOR_TEXT_SECONDARY; }

QPushButton[cssClass="aiSendBtn"] {
    background-color: @COLOR_ACCENT; color: @COLOR_BG_BASE;
    font-weight: bold; padding: 8px 10px; border-radius: @RADIUS_MD; font-size: @FONT_BASE;
}
QPushButton[cssClass="aiSendBtn"]:hover { background-color: @COLOR_ACCENT_HOVER; }
QPushButton[cssClass="aiSendBtn"]:disabled { background-color: @COLOR_BORDER; color: @COLOR_TEXT_SECONDARY; }

QPushButton[cssClass="aiHistoryToggleButton"] {
    background-color: @COLOR_BG_SURFACE;
    color: @COLOR_TEXT_PRIMARY;
    border: 1px solid @COLOR_BORDER;
    border-radius: @RADIUS_MD;
    padding: 7px 12px;
    font-weight: bold;
    font-size: @FONT_BASE;
}
QPushButton[cssClass="aiHistoryToggleButton"]:hover {
    border: 1px solid @COLOR_PRIMARY;
    background-color: @COLOR_ITEM_HOVER_BG;
}

QPushButton[cssClass="aiHistoryNewButton"] {
    background-color: @COLOR_ACCENT;
    color: @COLOR_BG_BASE;
    border: none;
    border-radius: @RADIUS_MD;
    padding: 9px 12px;
    font-weight: bold;
    font-size: @FONT_BASE;
}
QPushButton[cssClass="aiHistoryNewButton"]:hover {
    background-color: @COLOR_ACCENT_HOVER;
}

QPushButton[cssClass="aiHistoryIconButton"] {
    background-color: transparent;
    color: @COLOR_TEXT_SECONDARY;
    border: none;
    border-radius: @RADIUS_SM;
}
QPushButton[cssClass="aiHistoryIconButton"]:hover {
    background-color: @COLOR_ITEM_HOVER_BG;
}

QLineEdit[cssClass="aiInput"], QTextEdit[cssClass="aiInput"] {
    background-color: @COLOR_BG_SURFACE; color: @COLOR_TEXT_PRIMARY;
    padding: @SPACE_LG; border: 1px solid @COLOR_BORDER;
    border-radius: @RADIUS_MD; font-size: @FONT_MD;
}
QLineEdit[cssClass="aiInput"]:focus, QTextEdit[cssClass="aiInput"]:focus {
    border: 1px solid @COLOR_ACCENT;
}

QTextEdit[cssClass="aiChatInput"] {
    background-color: @COLOR_BG_SURFACE; color: @COLOR_TEXT_PRIMARY;
    padding: 8px 12px; border: 1px solid @COLOR_BORDER;
    border-radius: @RADIUS_MD; font-size: @FONT_MD;
}
QTextEdit[cssClass="aiChatInput"]:focus {
    border: 1px solid @COLOR_ACCENT;
}

QTextEdit[cssClass="aiTextEdit"] {
    background-color: transparent;
    border: none;
    color: @COLOR_TEXT_BODY;
    font-size: @FONT_MD;
}

QFrame[cssClass="aiCard"], QWidget[cssClass="aiCard"] {
    background-color: @COLOR_BG_SURFACE; border-radius: @RADIUS_LG;
    border: 1px solid @COLOR_BORDER;
}

QLabel[cssClass="cardLabel"] {
    color: @COLOR_TEXT_BODY; font-size: @FONT_BASE; font-weight: bold;
}
QLabel[cssClass="aiPrimaryText"] {
    color: @COLOR_TEXT_PRIMARY; font-size: @FONT_LG; font-weight: bold;
}
QLabel[cssClass="aiMetaText"] {
    color: @COLOR_TEXT_BODY; font-size: @FONT_BASE;
}
QLabel[cssClass="aiStrongMetaText"] {
    color: @COLOR_TEXT_PRIMARY; font-size: @FONT_BASE; font-weight: bold;
}
QLabel[cssClass="aiHintText"] {
    color: @COLOR_TEXT_SECONDARY; font-size: @FONT_BASE;
}
QLabel[cssClass="cardValueLarge"] {
    color: @COLOR_TEXT_PRIMARY; font-size: @FONT_XL; font-weight: bold;
}
QLabel[cssClass="priceValueLargeCyan"] {
    font-size: @FONT_2XL; font-weight: bold; color: @COLOR_ACCENT;
}
QLabel[cssClass="dateLabelMuted"] {
    color: @COLOR_TEXT_BODY; font-size: @FONT_BASE;
}
