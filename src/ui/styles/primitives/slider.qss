/* =======================================================
   PRIMITIVE - SLIDER
   Token referanslari: @TOKEN_ADI (bkz. src/ui/styles/tokens.py)
======================================================= */

QSlider::groove:horizontal {
    height: @SLIDER_GROOVE_HEIGHT;
    background: @SLIDER_GROOVE_BG;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: @SLIDER_HANDLE_BG;
    border: 2px solid @SLIDER_HANDLE_BORDER;
    width: @SLIDER_HANDLE_SIZE;
    height: @SLIDER_HANDLE_SIZE;
    border-radius: 7px;
    margin: -5px 0;
}
QSlider::handle:horizontal:hover {
    background: @SLIDER_HANDLE_BORDER;
}
QSlider::sub-page:horizontal {
    background: @SLIDER_HANDLE_BG;
    border-radius: 2px;
}
QSlider::add-page:horizontal {
    background: @SLIDER_GROOVE_BG;
    border-radius: 2px;
}

QSlider::groove:vertical {
    width: @SLIDER_GROOVE_HEIGHT;
    background: @SLIDER_GROOVE_BG;
    border-radius: 2px;
}
QSlider::handle:vertical {
    background: @SLIDER_HANDLE_BG;
    border: 2px solid @SLIDER_HANDLE_BORDER;
    width: @SLIDER_HANDLE_SIZE;
    height: @SLIDER_HANDLE_SIZE;
    border-radius: 7px;
    margin: 0 -5px;
}
QSlider::sub-page:vertical {
    background: @SLIDER_HANDLE_BG;
    border-radius: 2px;
}
QSlider::add-page:vertical {
    background: @SLIDER_GROOVE_BG;
    border-radius: 2px;
}
