/* =======================================================
   PRIMITIVE - BUTTONS
   Token referanslari: @TOKEN_ADI (bkz. src/ui/styles/tokens.py)
======================================================= */

QPushButton {
    background-color: @BUTTON_SECONDARY_BG;
    color: @BUTTON_SECONDARY_TEXT;
    border: 1px solid @BUTTON_SECONDARY_BORDER;
    padding: @SPACE_MD @SPACE_3XL;
    border-radius: @RADIUS_MD;
    font-weight: bold;
}
QPushButton:hover {
    background-color: @BUTTON_SECONDARY_BG_HOVER;
    border-color: @BUTTON_SECONDARY_BORDER_HOVER;
}
QPushButton:pressed {
    background-color: @BUTTON_SECONDARY_BG_PRESSED;
}
QPushButton:disabled {
    background-color: @BUTTON_DISABLED_BG;
    color: @BUTTON_DISABLED_TEXT;
    border-color: @BUTTON_DISABLED_BORDER;
}

QPushButton[type="primary"] {
    background-color: @BUTTON_PRIMARY_BG;
    color: @BUTTON_PRIMARY_TEXT;
    border: none;
}
QPushButton[type="primary"]:hover {
    background-color: @BUTTON_PRIMARY_BG_HOVER;
}
QPushButton[type="primary"]:pressed {
    background-color: @BUTTON_PRIMARY_BG_PRESSED;
}

QPushButton[type="success"] {
    background-color: #16a34a;
    color: white;
    border: none;
}
QPushButton[type="success"]:hover {
    background-color: @COLOR_SUCCESS_BRIGHT;
}

QPushButton[type="danger"] {
    background-color: @BUTTON_DANGER_BG;
    color: @BUTTON_DANGER_TEXT;
    border: none;
}
QPushButton[type="danger"]:hover {
    background-color: @BUTTON_DANGER_BG_HOVER;
}

QPushButton[type="ghost"] {
    background-color: transparent;
    border: none;
}
QPushButton[type="ghost"]:hover {
    background-color: @COLOR_BG_SURFACE;
}

QPushButton::menu-indicator {
    image: none;
    width: 0px;
}
