/* =======================================================
   SHARED - NAVIGATION
   Token referanslari: @TOKEN_ADI (bkz. src/ui/styles/tokens.py)
======================================================= */

#sidebar {
    background-color: @NAV_BG;
    border-right: 1px solid @NAV_BORDER;
}

#sidebar QLabel[cssClass="appTitle"] {
    color: @COLOR_TEXT_WHITE;
    font-size: @FONT_LG;
    font-weight: 700;
    padding: @SPACE_XL 0 @SPACE_2XL 0;
    margin-bottom: @SPACE_SM;
    border-top: 2px solid @COLOR_ACCENT;
}

QFrame[cssClass="navSeparator"] {
    background-color: @NAV_BORDER;
    margin: @SPACE_MD @SPACE_XL;
    max-height: 1px;
}

QPushButton[cssClass="navMenuBtn"] {
    background-color: transparent;
    color: @NAV_TEXT;
    border: none;
    border-left: 4px solid transparent;
    text-align: left;
    padding: @SPACE_LG @SPACE_XL;
    border-radius: @RADIUS_LG;
    font-size: @FONT_LG;
    font-weight: 500;
}
QPushButton[cssClass="navMenuBtn"]:hover {
    background-color: @NAV_HOVER_BG;
    color: @NAV_TEXT_ACTIVE;
}
QPushButton[cssClass="navMenuBtn"]:checked {
    background-color: @NAV_ACTIVE_BG;
    color: @NAV_TEXT_ACTIVE;
    border-left: 4px solid @COLOR_ACCENT;
    font-weight: 700;
}

QPushButton[cssClass="navBackBtn"] {
    background-color: transparent;
    color: @NAV_TEXT;
    border: 1px solid @BUTTON_OUTLINE_BORDER;
    padding: @SPACE_LG;
    border-radius: @RADIUS_LG;
    font-size: @FONT_MD;
    font-weight: 500;
}
QPushButton[cssClass="navBackBtn"]:hover {
    background-color: @NAV_HOVER_BG;
    color: @NAV_TEXT_ACTIVE;
}
QPushButton[cssClass="navBackBtn"]:disabled {
    color: @BUTTON_DISABLED_TEXT;
    border-color: @NAV_BORDER;
}
