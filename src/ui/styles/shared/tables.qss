/* =======================================================
   SHARED - TABLES
   QTableWidget cssClass varyantları ve global tablo overrides.
   Token referanslari: @TOKEN_ADI (bkz. src/ui/styles/tokens.py)
======================================================= */

QTableWidget[cssClass="tableSummary"] {
    background-color: @COLOR_BG_SURFACE;
    border-top: 2px solid @COLOR_BORDER;
    font-weight: bold;
    color: @COLOR_TEXT_PRIMARY;
}

QTableWidget[cssClass="dataTable"] {
    background-color: @COLOR_BG_BASE;
    border: none;
    gridline-color: transparent;
    outline: none;
}

QTableWidget[cssClass="dataTable"]::item {
    padding: @SPACE_LG;
    border: none;
    border-bottom: 1px solid @COLOR_BG_SURFACE;
}

QTableWidget[cssClass="dataTable"]::item:selected {
    background-color: @COLOR_BORDER;
}

QTableWidget[cssClass="dataTable"]::item:hover {
    background-color: @COLOR_BG_SURFACE;
}

QTableWidget[cssClass="dataTable"] QHeaderView::section {
    background-color: @COLOR_BG_BASE;
    color: @COLOR_TEXT_PRIMARY;
    padding: @SPACE_MD;
    border: none;
    border-bottom: 2px solid @COLOR_BORDER;
    font-weight: bold;
    text-transform: uppercase;
    font-size: @FONT_SM;
}

/* -------------------------------------------------------
   Global tablo okunabilirlik geçersiz kılmaları.
   dataTable bileşen kurallarından sonra gelmeli (cascade sırası).
------------------------------------------------------- */
QTableWidget {
    font-size: @FONT_TABLE_CELL;
    gridline-color: @COLOR_BORDER_SUBTLE;
}

QHeaderView::section {
    font-size: @FONT_MD;
    font-weight: bold;
    padding: 10px 8px;
    background-color: @COLOR_BG_SURFACE;
    color: @COLOR_TEXT_PRIMARY;
    border: none;
    border-bottom: 2px solid @COLOR_BORDER;
}

QTableWidget[cssClass="dataTable"] {
    font-size: @FONT_TABLE_CELL;
}

QTableWidget[cssClass="dataTable"]::item {
    padding: 6px 8px;
}

/* -------------------------------------------------------
   goalsTable — Hedef Takibi tablosu
------------------------------------------------------- */
QTableWidget[cssClass="goalsTable"] {
    background-color: @COLOR_BG_BASE;
    border: 1px solid @COLOR_BORDER;
    gridline-color: @COLOR_BORDER_SUBTLE;
    outline: none;
    font-size: @FONT_TABLE_CELL;
}

QTableWidget[cssClass="goalsTable"]::item {
    padding: 8px 10px;
    border: none;
}

QTableWidget[cssClass="goalsTable"]::item:alternate {
    background-color: @COLOR_BG_SURFACE;
}

QTableWidget[cssClass="goalsTable"]::item:selected {
    background-color: rgba(59, 130, 246, 0.18);
}

QTableWidget[cssClass="goalsTable"]::item:hover {
    background-color: @COLOR_BG_SURFACE;
}

QWidget[cssClass="tableActionContainer"] {
    background: transparent;
    background-color: transparent;
    border: none;
}
