/* =======================================================
   SHARED - FEEDBACK
   Toast / Snackbar bildirimleri.
   Token referanslari: @TOKEN_ADI (bkz. src/ui/styles/tokens.py)
======================================================= */

/* -------------------------------------------------------
   Toast Container — toastKind property'si ile
   her bildirim türü kendi tema-duyarlı renk setini alır.
   Light modda: TOAST_*_BG pastel; TOAST_TEXT koyu.
   Dark modda:  TOAST_*_BG koyu; TOAST_TEXT açık.
------------------------------------------------------- */

QWidget#toastContainer[toastKind="success"] {
    background-color: @TOAST_SUCCESS_BG;
    border: 1px solid @TOAST_SUCCESS_BORDER;
    border-radius: 10px;
}

QWidget#toastContainer[toastKind="error"] {
    background-color: @TOAST_ERROR_BG;
    border: 1px solid @TOAST_ERROR_BORDER;
    border-radius: 10px;
}

QWidget#toastContainer[toastKind="warning"] {
    background-color: @TOAST_WARNING_BG;
    border: 1px solid @TOAST_WARNING_BORDER;
    border-radius: 10px;
}

QWidget#toastContainer[toastKind="info"] {
    background-color: @TOAST_INFO_BG;
    border: 1px solid @TOAST_INFO_BORDER;
    border-radius: 10px;
}

/* -------------------------------------------------------
   Toast İçerik Elemanları
------------------------------------------------------- */

QLabel[cssClass="toastIcon"] {
    background: transparent;
    border: none;
}

QLabel[cssClass="toastMessage"] {
    background: transparent;
    color: @TOAST_TEXT;
    font-size: 14px;
    font-weight: 500;
    border: none;
}

QToolButton[cssClass="toastClose"] {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}

QToolButton[cssClass="toastClose"]:hover {
    background-color: @TOAST_CLOSE_HOVER_BG;
}

/* =======================================================
   MarketTickerBar — Piyasa Şeridi
   Dashboard ve Model Portföy sayfalarında header altında.
======================================================= */

QFrame#marketTickerBar {
    background-color: @COLOR_BG_SURFACE;
    border-top: 1px solid @COLOR_BORDER;
    border-bottom: 1px solid @COLOR_BORDER;
    border-radius: 0px;
}

QLabel[cssClass="tickerLabel"] {
    background: transparent;
    color: @COLOR_TEXT_BRIGHT;
    font-size: 13px;
    font-weight: 700;
    border: none;
}

QLabel[cssClass="tickerValue"] {
    background: transparent;
    color: @COLOR_ACCENT;
    font-size: 16px;
    font-weight: 700;
    border: none;
}

QFrame[cssClass="tickerSeparator"] {
    color: @COLOR_BORDER;
    background-color: @COLOR_BORDER;
    max-width: 1px;
    min-height: 24px;
    max-height: 24px;
    margin: 14px 0px;
}
