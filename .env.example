# Yerel veritabanları (SQLite = işlemsel veri, DuckDB = piyasa geçmişi).
# Göreli yollar çalışma dizinine değil uygulama köküne göre çözülür.
DB_SQLITE_PATH=data/portfolio.db
# DuckDB dosyası varsayılan olarak SQLite dosyasının yanındaki market_history.duckdb'dir; değiştirmek için:
# DUCKDB_PATH=data/market_history.duckdb

GEMINI_API_KEY=change-me
AI_CORE_API_URL=http://localhost:8000
EVDS_API_KEY=
TCMB_DEPOSIT_RATE_FALLBACK=45.0

LOG_DIR=logs
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=DEBUG
LOG_FILE_LEVEL=INFO
