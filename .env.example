# DB_ENGINE: "mysql" (varsayılan) veya "sqlite". Bkz. TRANSFORMATION_PLAN.md §2/§9.1.
DB_ENGINE=mysql

DB_HOST=localhost
DB_PORT=3306
DB_USER=portfoy_user
DB_PASSWORD=change-me
DB_NAME=portfoySim
POOL_NAME=portfoy_pool
POOL_SIZE=5
DB_POOL_RECYCLE_SECONDS=3600
DB_POOL_PRE_PING=true

# DB_ENGINE=sqlite iken kullanılır:
DB_SQLITE_PATH=data/portfolio.db

GEMINI_API_KEY=change-me
AI_CORE_API_URL=http://localhost:8000
EVDS_API_KEY=
TCMB_DEPOSIT_RATE_FALLBACK=45.0

LOG_DIR=logs
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=DEBUG
LOG_FILE_LEVEL=INFO
